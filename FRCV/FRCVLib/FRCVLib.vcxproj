    <!--
      Generated by the PreBuildEvent below from swig.i - NOT just a C# codegen concern.
      swig_wrap.cxx is the actual C++ translation unit that defines every P/Invoke-callable
      exported entry point (SWIGRegisterExceptionCallbacks_libFRCVLib, new_Logger__SWIG_1,
      etc.) that Server/FRCVCore's generated C# classes call into. Without it in this
      ItemGroup, libFRCVLib.so builds and links "successfully" (every symbol it actually
      references resolves fine - there's nothing in this project's own .cpp files that calls
      into swig_wrap.cxx) but exports none of those entry points, so the C# server throws
      System.EntryPointNotFoundException the moment it touches anything SWIG-generated.
      Confirmed by actually running the server, not caught by any earlier compile/link check
      in this project's history - every one of those checked FRCVLib in isolation, never
      Server calling into it.
    -->
    <ClCompile Include="swig_wrap.cxx" />
  </ItemGroup>
  <ItemGroup>
    <None Include="swig.i" />
    <None Include="Local.props.example" />
  </ItemGroup>

  <!--
    PreBuildEvent commands run locally (via cmd.exe on Windows), even for this Linux/WSL2/
    Remote_GCC-toolset project - only ClCompile/Link get proxied to the remote build machine.
    swig.exe must be on the Windows PATH (see Local.props.example / README.md); Server.csproj's
    own RunSwig target regenerates the same C# files again as a fallback for building Server
    standalone, but only THIS step also produces swig_wrap.cxx, so it cannot be skipped even
    when Server.csproj's copy of the bindings happens to already be up to date.
  -->
  <PropertyGroup>
    <PreBuildEvent>
      <Command>swig -c++ -csharp -DFRCV_WITH_ONNX -DFRCV_WITH_NT4 -DFRCV_WITH_WEBRTC -DFRCV_WITH_VULKAN_APRILTAG -outdir ..\Server\FRCVCore -o swig_wrap.cxx swig.i</Command>
    </PreBuildEvent>
  </PropertyGroup>

