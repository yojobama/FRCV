  <!--
    Feature flags: since the build stays MSBuild-only (no CMake), optional backends are
    toggled via preprocessor defines instead of build options. FRCV_WITH_RKNN is ARM64-only
    so the WSL x64 configuration never needs the RKNN SDK installed.
  -->
  <PropertyGroup Label="FeatureFlags">
    <FrcvCommonDefines>FRCV_WITH_ONNX;FRCV_WITH_NT4;FRCV_WITH_WEBRTC;FRCV_WITH_VULKAN_APRILTAG</FrcvCommonDefines>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='ARM64'">
    <FrcvPlatformDefines>FRCV_WITH_RKNN</FrcvPlatformDefines>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <FrcvPlatformDefines></FrcvPlatformDefines>
  </PropertyGroup>

