{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "my-windows-x64-release",
            "displayName": "My machine: Windows x64 Release",
            "inherits": "windows-x64-release",
            "cacheVariables": {
                "OpenCV_DIR": "C:/deps",
                "ONNXRUNTIME_ROOT": "C:/deps/onnxruntime-win-x64-1.20.0",
                "WPILIB_ROOT": "C:/deps/wpilib-2025.3.2-windowsx86-64",
                "PKG_CONFIG_EXECUTABLE": "C:/path/to/vcpkg/installed/x64-windows/tools/pkgconf/pkgconf.exe",
                "CMAKE_PREFIX_PATH": "C:/deps;C:/path/to/vcpkg/installed/x64-windows"
            },
            "environment": {
                "PKG_CONFIG_PATH": "C:/path/to/vcpkg/installed/x64-windows/lib/pkgconfig"
            }
        },
        {
            "name": "my-windows-x64-debug",
            "displayName": "My machine: Windows x64 Debug",
            "inherits": "windows-x64-debug",
            "vendor": {
                "comment": "Only worth configuring once OpenCV is ALSO built in Debug: MSVC Debug/Release builds are ABI-incompatible (OpenCV wraps Debug-mode symbols in an inline cv::debug_build_guard namespace specifically to turn a mismatch into a link error instead of silent corruption - confirmed the hard way, 27 unresolved externals, the first time this preset was linked against a Release-only OpenCV_DIR). Building OpenCV twice (Release + Debug) is a second multi-hour from-source build; my-windows-x64-release alone is enough to prove the native Windows build works."
            },
            "cacheVariables": {
                "OpenCV_DIR": "C:/deps",
                "ONNXRUNTIME_ROOT": "C:/deps/onnxruntime-win-x64-1.20.0",
                "WPILIB_ROOT": "C:/deps/wpilib-2025.3.2-windowsx86-64",
                "PKG_CONFIG_EXECUTABLE": "C:/path/to/vcpkg/installed/x64-windows/tools/pkgconf/pkgconf.exe",
                "CMAKE_PREFIX_PATH": "C:/deps;C:/path/to/vcpkg/installed/x64-windows"
            },
            "environment": {
                "PKG_CONFIG_PATH": "C:/path/to/vcpkg/installed/x64-windows/lib/pkgconfig"
            }
        },
        {
            "name": "my-pi-arm64-release",
            "displayName": "My machine: Orange Pi ARM64 Release",
            "inherits": "pi-arm64-release",
            "vendor": {
                "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
                    "sshCommand": "ssh photon@192.168.55.139"
                }
            }
        }
    ],
    "buildPresets": [
        { "name": "my-windows-x64-debug",   "configurePreset": "my-windows-x64-debug",   "configuration": "Debug" },
        { "name": "my-windows-x64-release", "configurePreset": "my-windows-x64-release", "configuration": "Release" }
    ]
}
