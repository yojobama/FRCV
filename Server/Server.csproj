<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;LocalCheck</Configurations>

    <!--
      FRCVLib is built by Visual Studio's WSL2/Remote_GCC toolset (see FRCVLib.vcxproj), not by
      MSBuild's normal C# build graph, so it is consumed as a prebuilt native library rather than
      via <ProjectReference> — that also lets Server build/publish (e.g. `dotnet publish -r
      linux-arm64`) without a C++ toolchain on the machine, as long as the .so already exists.
      Override FRCVLibPlatform/FRCVLibConfiguration (e.g. -p:FRCVLibPlatform=ARM64) to pick up a
      build produced by a different FRCVLib configuration than the one implied by $(Configuration).
    -->
    <!--
      Server.csproj is always built as "Any CPU" - the .sln maps every Server
      Debug|ARM64/Release|ARM64 solution configuration to Server's own Debug|Any CPU /
      Release|Any CPU (a C# project has no real notion of ARM64 vs x64), so $(Platform) inside
      this project is never ARM64 even when the solution's active platform is ARM64 for
      deploying to the Orange Pi. FRCVLibPlatform must therefore be inferred from something that
      *does* carry the intended target architecture: $(RuntimeIdentifier), which VS's SSH remote
      debug/publish target sets to linux-arm64 when deploying to an ARM64 SSH target (and which
      `dotnet publish -r` sets directly). Confirmed the hard way: deploying to the Orange Pi
      without this silently picked up the x64 (WSL2-built) libFRCVLib.so instead of an ARM64
      one, which was then copied into the app's output and pushed to the ARM64 device, where the
      x86-64 ELF cannot be dlopen()'d - producing a DllNotFoundException at runtime
      ("...or one of its dependencies... module could not be found") with no build-time warning
      at all.
    -->
    <FRCVLibPlatform Condition="'$(FRCVLibPlatform)'=='' And '$(RuntimeIdentifier)'=='linux-arm64'">ARM64</FRCVLibPlatform>
    <FRCVLibPlatform Condition="'$(FRCVLibPlatform)'==''">x64</FRCVLibPlatform>
    <FRCVLibConfiguration Condition="'$(FRCVLibConfiguration)'==''">$(Configuration)</FRCVLibConfiguration>
    <FRCVLibConfiguration Condition="'$(FRCVLibConfiguration)'=='LocalCheck'">Debug</FRCVLibConfiguration>
    <FRCVLibBuildDir>..\FRCVLib\bin\$(FRCVLibPlatform)\$(FRCVLibConfiguration)</FRCVLibBuildDir>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="FRCVCore\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EmbedIO" Version="3.5.2" />
    <PackageReference Include="HttpMultipartParser" Version="10.0.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.10" />
  </ItemGroup>

  <!--
    CopyToOutputDirectory must be Always, not PreserveNewest: PreserveNewest only compares file
    timestamps, and libFRCVLib.so is copied to the SAME output filename regardless of which
    FRCVLibPlatform it came from. Building ARM64 (for an Orange Pi deploy) and then switching
    back to a plain x64 build (e.g. for local WSL2 debugging) without a clean lands an x64-newer
    source next to an already-copied ARM64 output file that's newer still (from the earlier
    build) - PreserveNewest sees the destination as "already newest" and skips the copy,
    silently leaving the wrong-architecture .so in the output directory. Confirmed the hard way:
    reproduced exactly this (a stale ARM64 libFRCVLib.so left in Server/bin/Debug/net10.0 after
    an x64-only `dotnet build`), which is indistinguishable at runtime from the DllNotFoundException
    this project hit for the opposite mismatch (x64 .so deployed to an ARM64 device).
  -->
  <ItemGroup>
    <Content Include="$(FRCVLibBuildDir)\libFRCVLib.so" Condition="Exists('$(FRCVLibBuildDir)\libFRCVLib.so')">
      <Link>libFRCVLib.so</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The React WebUI (reactproject1) is a separate npm/Vite project, not part of this C# build
    graph - `npm run build` there produces reactproject1\dist, which Program.cs serves as static
    files from a "wwwroot" folder next to Server.dll. Guarded on Exists() the same way as
    libFRCVLib.so above: a machine that hasn't built the WebUI yet still builds and runs Server
    fine (Program.cs falls back to API-only with a warning), rather than failing the build over a
    separate project's output.
  -->
  <ItemGroup>
    <Content Include="wwwroot\**" Exclude="wwwroot\dist\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\reactproject1\dist\**" Condition="Exists('..\reactproject1\dist')">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    A missing/wrong-architecture libFRCVLib.so is otherwise silent at build time (the Content
    item above just has no match) and only surfaces as a runtime DllNotFoundException on
    whatever machine ends up running Server.dll - a much harder place to diagnose it, especially
    once it's been deployed to a remote target. Fail the build instead.
  -->
  <Target Name="CheckFRCVLibExists" BeforeTargets="Build;Publish">
    <Error Text="libFRCVLib.so not found at '$(FRCVLibBuildDir)\libFRCVLib.so' (FRCVLibPlatform=$(FRCVLibPlatform), FRCVLibConfiguration=$(FRCVLibConfiguration)). Build FRCVLib for that platform/configuration first, or override -p:FRCVLibPlatform=/-p:FRCVLibConfiguration=."
           Condition="!Exists('$(FRCVLibBuildDir)\libFRCVLib.so')" />
  </Target>

  <!--
    Regenerates the SWIG C# bindings from FRCVLib's public API before each build. Skipped when
    swig isn't on PATH so a machine that only runs the published server (no dev toolchain) isn't
    forced to have it installed; the checked-in FRCVCore sources are then whatever was last
    generated on a dev machine.

    Two things this needs beyond just invoking swig:
    - FRCVCore is cleared first. SWIG only ever adds/overwrites files for types that still
      exist; a type removed from swig.i (as happened when Frame/FrameSpec were dropped) leaves
      its old wrapper .cs files behind as stale dead code otherwise.
    - The generated .cs files are added to @(Compile) explicitly via an ItemGroup *inside this
      target*. SDK-style projects capture the implicit **/*.cs glob once, at project evaluation
      time, before any target runs — a file swig creates during this same build (e.g. the first
      time a new %template is added) would otherwise silently not compile until a second build.
  -->
  <Target Name="RunSwig" BeforeTargets="BeforeBuild">
    <!--
      `where` is a Windows-only command (cmd.exe); on Linux/WSL the Exec task still runs
      through a shell, but `where` simply doesn't exist there (exit 127) - confirmed the hard
      way: building on Linux with swig genuinely installed still reported "swig not found",
      because the check itself was Windows-only, not because swig was actually missing. Use
      $(OS) (built into MSBuild; 'Windows_NT' on Windows, unset/different on Unix) to pick the
      right probe.
    -->
    <Exec Command="where swig" Condition="'$(OS)'=='Windows_NT'" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="SwigCheckExitCode" />
    </Exec>
    <Exec Command="command -v swig" Condition="'$(OS)'!='Windows_NT'" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="SwigCheckExitCode" />
    </Exec>
    <ItemGroup Condition="'$(SwigCheckExitCode)'=='0'">
      <_StaleSwigOutput Include="FRCVCore\*.cs" />
    </ItemGroup>
    <Delete Files="@(_StaleSwigOutput)" Condition="'$(SwigCheckExitCode)'=='0'" />
    <!--
      -D flags here must mirror FRCVLib.vcxproj's FrcvCommonDefines - SWIG runs its own
      preprocessor pass over swig.i/Manager.h independent of the actual C++ compiler, so an
      #ifdef-guarded API (e.g. the NT4 methods) needs the same defines here or SWIG silently
      skips generating C# bindings for it even though the .so was built with it enabled. FRCV_WITH_RKNN
      is deliberately excluded: it never appears in Manager.h's guarded surface today, and it's
      ARM64-only, so this (host-side) swig invocation shouldn't imply it's available.

      Forward slashes in the paths below, not backslashes: this Exec runs through a POSIX shell
      on Linux, where a literal backslash is not a path separator.
    -->
    <Exec Command="swig -c++ -csharp -DFRCV_WITH_ONNX -DFRCV_WITH_NT4 -DFRCV_WITH_WEBRTC -DFRCV_WITH_VULKAN_APRILTAG -DFRCV_WITH_CODEC_STEREO -outdir ./FRCVCore ../FRCVLib/swig.i" Condition="'$(SwigCheckExitCode)'=='0'" />
    <Warning Text="swig not found on PATH; using whatever bindings already exist in FRCVCore\." Condition="'$(SwigCheckExitCode)'!='0'" />
    <ItemGroup>
      <Compile Include="FRCVCore\*.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

</Project>
