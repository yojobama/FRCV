<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;LocalCheck</Configurations>

    <!-- The Pi's deploy image has no libicu installed, and a self-contained publish doesn't
         bundle it - .NET dynamically loads it at startup, so without this every deploy target
         needs a new apt dependency or crashes with FailFast("Couldn't find a valid ICU package")
         the instant LinuxResourceMonitor's first Console.WriteLine touches the encoding. Nothing
         here does culture-aware string work (LinuxResourceMonitor.cs already parses with
         CultureInfo.InvariantCulture) - invariant mode is a real fit, not a workaround. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      LumenCore is built by CMake (see /CMakeLists.txt, /CMakePresets.json, LumenCore/CMakeLists.txt),
      not by MSBuild's normal C# build graph, so it is consumed as a prebuilt native library rather
      than via <ProjectReference> — that also lets Server build/publish (e.g. `dotnet publish -r
      linux-arm64`) without a C++ toolchain on the machine, as long as the library already exists.
      Override LumenCorePreset directly (e.g. -p:LumenCorePreset=pi-arm64-release) to pick up a
      build produced by a different preset than the one inferred below.
    -->
    <!--
      $(RuntimeIdentifier), not $(OS), decides which preset to look for - and RID must be checked
      FIRST, with $(OS) only as a last-resort fallback when RID gives no signal at all. $(OS) is
      the BUILD HOST, not the target: deploy.ps1 runs `dotnet publish -r linux-arm64` FROM WINDOWS,
      where $(OS)=='Windows_NT' - keying off $(OS) first there would resolve to the Windows preset
      and bundle a Windows-built LumenCore.dll into a linux-arm64 publish. That is exactly the
      DllNotFoundException class of bug this project already hit once with the old LumenCorePlatform
      property (deploying to the Orange Pi silently picked up the x64/WSL2-built library instead of
      an ARM64 one - an x86-64 ELF cannot be dlopen()'d on aarch64, and there was no build-time
      warning at all, only a runtime failure on the deployed device).
    -->
    <LumenCorePresetBase Condition="'$(LumenCorePresetBase)'=='' And '$(RuntimeIdentifier)'=='linux-arm64'">pi-arm64</LumenCorePresetBase>
    <LumenCorePresetBase Condition="'$(LumenCorePresetBase)'=='' And '$(RuntimeIdentifier)'=='linux-x64'">wsl-x64</LumenCorePresetBase>
    <LumenCorePresetBase Condition="'$(LumenCorePresetBase)'=='' And $([MSBuild]::ValueOrDefault('$(RuntimeIdentifier)', '').StartsWith('win'))">windows-x64</LumenCorePresetBase>
    <LumenCorePresetBase Condition="'$(LumenCorePresetBase)'=='' And '$(OS)'=='Windows_NT'">windows-x64</LumenCorePresetBase>
    <LumenCorePresetBase Condition="'$(LumenCorePresetBase)'==''">wsl-x64</LumenCorePresetBase>

    <!-- CMakePresets.json's preset names are lowercase ("wsl-x64-debug"); the multi-config
         generators' own per-configuration output subdirectory is title-case ("Debug"/"Release"),
         matching exactly what cmake's own build/config options expect - both are needed, for the
         preset name and the stage subdirectory respectively. LocalCheck maps to Debug, same as
         the old LumenCoreConfiguration property did. -->
    <LumenCoreConfigLower Condition="'$(Configuration)'=='Release'">release</LumenCoreConfigLower>
    <LumenCoreConfigLower Condition="'$(Configuration)'!='Release'">debug</LumenCoreConfigLower>
    <LumenCoreConfigTitle Condition="'$(Configuration)'=='Release'">Release</LumenCoreConfigTitle>
    <LumenCoreConfigTitle Condition="'$(Configuration)'!='Release'">Debug</LumenCoreConfigTitle>

    <LumenCorePreset Condition="'$(LumenCorePreset)'==''">$(LumenCorePresetBase)-$(LumenCoreConfigLower)</LumenCorePreset>
    <LumenCoreStageDir>$(MSBuildThisFileDirectory)..\out\build\$(LumenCorePreset)\stage\$(LumenCoreConfigTitle)</LumenCoreStageDir>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Interop\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EmbedIO" Version="3.5.2" />
    <PackageReference Include="HttpMultipartParser" Version="10.0.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.10" />
  </ItemGroup>

  <!--
    Globs the CMake stage directory rather than hardcoding one filename (libLumenCore.so vs
    LumenCore.dll, plus every DLL it transitively depends on - OpenCV, ONNX Runtime, ntcore,
    ffmpeg, libdatachannel - which LumenCore/CMakeLists.txt's own POST_BUILD step already copies
    next to it on Windows, since Windows has no rpath/LD_LIBRARY_PATH equivalent). This is what
    keeps this list from needing to be kept in sync by hand on the C# side as dependencies change.

    CopyToOutputDirectory must be Always, not PreserveNewest: PreserveNewest only compares file
    timestamps, and the native library is copied to the SAME output filename regardless of which
    preset it came from. Building pi-arm64-release (for an Orange Pi deploy) and then switching
    back to wsl-x64-debug (for local debugging) without a clean lands a newer wsl source next to
    an already-copied pi-arm64 output that's newer still (from the earlier build) - PreserveNewest
    sees the destination as "already newest" and skips the copy, silently leaving the
    wrong-architecture library in the output directory. Confirmed the hard way in the previous,
    single-file version of this same problem.
  -->
  <ItemGroup>
    <LumenCoreStageFiles Include="$(LumenCoreStageDir)\*.so;$(LumenCoreStageDir)\*.dll" Condition="Exists('$(LumenCoreStageDir)')" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="@(LumenCoreStageFiles)">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The React WebUI (webui) is a separate npm/Vite project, not part of this C# build graph -
    `npm run build` there produces webui\dist, which Program.cs serves as static files from a
    "wwwroot" folder next to Server.dll. Guarded on Exists() the same way as the native library
    above: a machine that hasn't built the WebUI yet still builds and runs Server fine
    (Program.cs falls back to API-only with a warning), rather than failing the build over a
    separate project's output.
  -->
  <ItemGroup>
    <Content Include="wwwroot\**" Exclude="wwwroot\dist\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\webui\dist\**" Condition="Exists('..\webui\dist')">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Builds LumenCore via CMake before Server itself, so a plain `dotnet build` in this directory
    still "just works" the way it always has, without requiring a separate manual CMake step or
    routing everything through Visual Studio's own CMake integration first. Mirrors the role the
    old RunSwig target played (it silently regenerated bindings before each build) but invokes
    CMake instead of swig directly - CMake now owns the SWIG invocation (LumenCore/CMakeLists.txt).

    Skipped gracefully, with a warning rather than a hard failure, when cmake isn't on PATH or the
    preset has never been configured (no CMakeCache.txt yet) - a machine that only runs an
    already-published server has no reason to need a C++ toolchain at all. CheckLumenCoreExists
    below is what turns a genuinely missing native library into a hard, clearly-worded failure;
    this target's job is only to build one that's known to be configured already.
  -->
  <Target Name="BuildLumenCore" BeforeTargets="BeforeBuild">
    <Exec Command="where cmake" Condition="'$(OS)'=='Windows_NT'" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="CMakeCheckExitCode" />
    </Exec>
    <Exec Command="command -v cmake" Condition="'$(OS)'!='Windows_NT'" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="CMakeCheckExitCode" />
    </Exec>
    <PropertyGroup>
      <LumenCoreConfigured>false</LumenCoreConfigured>
      <LumenCoreConfigured Condition="Exists('$(MSBuildThisFileDirectory)..\out\build\$(LumenCorePreset)\CMakeCache.txt')">true</LumenCoreConfigured>
    </PropertyGroup>
    <Exec Command="cmake --build --preset $(LumenCorePreset)"
          WorkingDirectory="$(MSBuildThisFileDirectory).."
          Condition="'$(CMakeCheckExitCode)'=='0' And '$(LumenCoreConfigured)'=='true'" />
    <Warning Text="cmake not found on PATH; using whatever LumenCore build already exists for preset '$(LumenCorePreset)'."
             Condition="'$(CMakeCheckExitCode)'!='0'" />
    <Warning Text="Preset '$(LumenCorePreset)' has never been configured (no CMakeCache.txt under out/build/$(LumenCorePreset)) - run `cmake --preset $(LumenCorePreset)` first. Using whatever build already exists, if any."
             Condition="'$(CMakeCheckExitCode)'=='0' And '$(LumenCoreConfigured)'!='true'" />
  </Target>

  <!--
    A missing/wrong-architecture native library, or C# bindings that were generated by a
    DIFFERENT configure than the one that built it, are otherwise silent at build time (the
    Content item above just has no match) and only surface as a runtime DllNotFoundException or
    EntryPointNotFoundException on whatever machine ends up running Server.dll - a much harder
    place to diagnose it, especially once it's been deployed to a remote target. Fail the build
    instead, checking both: that the library exists, and that the Interop bindings next to it
    came from an actual CMake configure (the .swig-stamp LumenCore/CMakeLists.txt writes) rather
    than, say, a stale checked-out copy from a different preset entirely.
  -->
  <Target Name="CheckLumenCoreExists" BeforeTargets="Build;Publish">
    <ItemGroup>
      <_LumenCoreNativeLib Include="$(LumenCoreStageDir)\libLumenCore.so" Condition="Exists('$(LumenCoreStageDir)\libLumenCore.so')" />
      <_LumenCoreNativeLib Include="$(LumenCoreStageDir)\LumenCore.dll" Condition="Exists('$(LumenCoreStageDir)\LumenCore.dll')" />
    </ItemGroup>
    <Error Text="LumenCore native library not found under '$(LumenCoreStageDir)' for preset '$(LumenCorePreset)'. Build it first: cmake --preset $(LumenCorePreset) &amp;&amp; cmake --build --preset $(LumenCorePreset) - or override -p:LumenCorePreset=/-p:LumenCorePresetBase=."
           Condition="'@(_LumenCoreNativeLib)'==''" />
    <Error Text="Server/Interop/.swig-stamp not found - the C# bindings next to the native library above were never generated by an actual CMake configure. Run: cmake --preset $(LumenCorePreset)"
           Condition="!Exists('$(MSBuildThisFileDirectory)Interop\.swig-stamp')" />
  </Target>

</Project>
